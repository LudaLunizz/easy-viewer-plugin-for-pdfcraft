+/// Draw the viewer mode's strip: home, the document tabs (click, close button, middle click and
+/// right-click menu as in the full strip, scrolling when they don't fit), Open and the button that
+/// leaves viewer mode. Nothing else of the window's chrome shows.
+pub fn viewer_tab_strip(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    let t = Tokens::get(ui.ctx());
+    let mac = cfg!(target_os = "macos") && app.integrated_titlebar;
+    let left = if mac { MAC_CONTENT_LEFT as i8 } else { 8 };
+    let (tab_h, button) = if mac { (MAC_TITLE_BAR - 2.0, 24.0) } else { (TAB_HEIGHT, STRIP_BUTTON) };
+    egui::Panel::top("viewer_tab_strip")
+        .exact_size(if mac { MAC_TITLE_BAR } else { TAB_STRIP })
+        .frame(egui::Frame::NONE.fill(t.titlebar).inner_margin(egui::Margin { left, right: 10, top: 0, bottom: 0 }))
+        .show(ui, |ui| {
+            let full = ui.max_rect();
+            app.panes.main_strip = Some(full);
+            let drag = ui.interact(full, ui.scope_id().with("titledrag"), Sense::click_and_drag());
+            if drag.drag_started() {
+                window_controls::desktop_grab(ui.ctx(), egui::ViewportCommand::StartDrag);
+            }
+            if drag.double_clicked() {
+                let max = ui.ctx().input(|i| i.viewport().maximized.unwrap_or(false));
+                ui.ctx().send_viewport_cmd(egui::ViewportCommand::Maximized(!max));
+            }
+            let fullscreen = ui.ctx().input(|i| i.viewport().fullscreen.unwrap_or(false));
+            let controls = app
+                .window_controls
+                .clone()
+                .filter(|_| app.draws_window_frame() && !fullscreen)
+                .unwrap_or_else(|| window_controls::Layout { left: Vec::new(), right: Vec::new() });
+            ui.horizontal_centered(|ui| {
+                ui.spacing_mut().item_spacing.x = 4.0;
+                if !controls.left.is_empty() {
+                    ui.scope(|ui| {
+                        ui.spacing_mut().item_spacing.x = 0.0;
+                        window_controls::buttons(ui, &controls.left);
+                    });
+                    ui.add_space(window_controls::SIDE_GAP - 4.0);
+                }
+                if icons::button(ui, "house", button, app.active.is_none(), tl!("Home")).clicked() {
+                    app.active = None;
+                    app.combine_tab.focused = false;
+                }
+                // The Open button, the exit button and the window controls stay outside the tabs.
+                let open_width = ui.fonts_mut(|f| f.layout_no_wrap(tl!("Open").into(), theme::medium(13.0), t.text).size().x) + 38.0 + 12.0;
+                let tabs_width = (ui.available_width() - button - open_width - 16.0 - window_controls::width(&controls.right)).max(0.0);
+                let tabs = app.tabs_in(Place::Main);
+                let natural: Vec<f32> = tabs.iter().filter_map(|&i| crate::canvas::tab_label(app, i)).map(|name| tab_natural_width(ui, &t, &name)).collect();
+                let gap = ui.spacing().item_spacing.x;
+                let cap = tab_cap(&natural, tabs_width, gap, TAB_MIN_WIDTH);
+                // Keyed by document, so the tab that comes forward scrolls into sight.
+                let state = (app.active_ids().map(|(_, id)| id), app.views.len());
+                let changed = ui.data_mut(|data| {
+                    let id = ui.scope_id().with("viewer_active_tab");
+                    let changed = data.get_temp::<(Option<pdfcraft_engine::DocId>, usize)>(id) != Some(state);
+                    data.insert_temp(id, state);
+                    changed
+                });
+                let mut action = None;
+                let mut close = None;
+                ui.scope(|ui| {
+                    ui.style_mut().always_scroll_the_only_direction = true;
+                    egui::ScrollArea::horizontal().id_salt("viewer_tabs").max_width(tabs_width).auto_shrink([true, true]).show(ui, |ui| {
+                        ui.horizontal_centered(|ui| {
+                            for &i in &tabs {
+                                let Some(doc) = app.session.get(app.views[i].id) else { continue };
+                                let Some(name) = crate::canvas::tab_label(app, i) else { continue };
+                                let dirty = doc.dirty;
+                                let file = (name != doc.name).then_some(doc.name.as_str());
+                                let response = tab(
+                                    ui,
+                                    TabSpec {
+                                        id: ui.scope_id().with(("viewer-tab", app.views[i].id)),
+                                        theme: &t,
+                                        icon: "file-text",
+                                        name: &name,
+                                        file,
+                                        dirty,
+                                        active: app.pane_front(Place::Main) == Some(i),
+                                        index: i,
+                                        cap,
+                                        height: tab_h,
+                                        draggable: false,
+                                    },
+                                    &mut close,
+                                );
+                                if changed && app.active == Some(i) {
+                                    response.scroll_to_me(Some(Align::Center));
+                                }
+                                response.context_menu(|ui| tab_menu(app, ui, i, &mut action));
+                                if response.clicked() {
+                                    app.active = Some(i);
+                                    app.combine_tab.focused = false;
+                                }
+                                // A middle click closes the tab; unsaved changes ask first.
+                                if response.middle_clicked() {
+                                    close = Some(i);
+                                }
+                            }
+                        });
+                    });
+                });
+                if let Some(i) = close
+                    && let Some(view) = app.views.get(i)
+                {
+                    action.get_or_insert(Action::Close(view.view_key()));
+                }
+                if let Some(action) = action {
+                    app.tab_action(action);
+                }
+                ui.add_space(4.0);
+                let tip = crate::commands::command_tip(ui.ctx(), tl!("Open a PDF ({key})"), "file.open");
+                if widgets::ghost_button_sized(ui, "plus", tl!("Open"), tab_h).on_hover_text(tip).clicked() {
+                    app.open_dialog();
+                }
+                ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
+                    if !controls.right.is_empty() {
+                        let size = egui::vec2(window_controls::width(&controls.right) - window_controls::SIDE_GAP, window_controls::BUTTON);
+                        ui.allocate_ui_with_layout(size, Layout::left_to_right(Align::Center), |ui| {
+                            ui.spacing_mut().item_spacing.x = 0.0;
+                            window_controls::buttons(ui, &controls.right);
+                        });
+                        ui.add_space(window_controls::SIDE_GAP - 4.0);
+                    }
+                    let tip = crate::commands::command_tip(ui.ctx(), tl!("Leave viewer mode ({key} or Esc)"), "view.viewer_mode");
+                    if icons::button(ui, "eye-off", button, true, &tip).clicked() {
+                        app.execute("view.viewer_mode");
+                    }
+                });
+            });
+        });
+}

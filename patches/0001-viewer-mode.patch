diff --git a/crates/ui-egui/src/chrome.rs b/crates/ui-egui/src/chrome.rs
index 4cc264e..83774f6 100644
--- a/crates/ui-egui/src/chrome.rs
+++ b/crates/ui-egui/src/chrome.rs
@@ -586,6 +586,90 @@ const MODE_BAR_RIGHT: f32 = 3.0 * 32.0 + 3.0 * 4.0 + 8.0;
 /// Narrowest search field the mode bar shows; below it the field becomes an icon button.
 const MODE_BAR_SEARCH_MIN: f32 = 140.0;
 
+/// Draw the viewer tab strip: minimal tab bar for the clean multi-PDF viewer.
+/// Shows only document tabs and an "Exit Viewer" toggle button.
+pub fn viewer_tab_strip(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    let t = Tokens::get(ui.ctx());
+    let mac = cfg!(target_os = "macos") && app.integrated_titlebar;
+    let left = if mac { MAC_CONTENT_LEFT as i8 } else { 8 };
+    let (tab_h, button) = if mac { (MAC_TITLE_BAR - 2.0, 24.0) } else { (TAB_HEIGHT, STRIP_BUTTON) };
+    egui::Panel::top("viewer_tab_strip")
+        .exact_size(if mac { MAC_TITLE_BAR } else { TAB_STRIP })
+        .frame(egui::Frame::NONE.fill(t.titlebar).inner_margin(egui::Margin { left, right: 10, top: 0, bottom: 0 }))
+        .show(ui, |ui| {
+            let full = ui.max_rect();
+            app.panes.main_strip = Some(full);
+            let drag = ui.interact(full, ui.scope_id().with("titledrag"), Sense::click_and_drag());
+            if drag.drag_started() {
+                window_controls::desktop_grab(ui.ctx(), egui::ViewportCommand::StartDrag);
+            }
+            if drag.double_clicked() {
+                let max = ui.ctx().input(|i| i.viewport().maximized.unwrap_or(false));
+                ui.ctx().send_viewport_cmd(egui::ViewportCommand::Maximized(!max));
+            }
+            let fullscreen = ui.ctx().input(|i| i.viewport().fullscreen.unwrap_or(false));
+            let controls = app
+                .window_controls
+                .clone()
+                .filter(|_| app.draws_window_frame() && !fullscreen)
+                .unwrap_or_else(|| window_controls::Layout { left: Vec::new(), right: Vec::new() });
+            ui.horizontal_centered(|ui| {
+                ui.spacing_mut().item_spacing.x = 4.0;
+                if !controls.left.is_empty() {
+                    ui.scope(|ui| {
+                        ui.spacing_mut().item_spacing.x = 0.0;
+                        window_controls::buttons(ui, &controls.left);
+                    });
+                    ui.add_space(window_controls::SIDE_GAP - 4.0);
+                }
+                // Home button
+                if icons::button(ui, "house", button, app.active.is_none() && !app.combine_showing(), tl!("Home")).clicked() {
+                    app.active = None;
+                    app.combine_tab.focused = false;
+                }
+                ui.add_space(8.0);
+                // Open button
+                if icons::button(ui, "file-plus", button, false, tl!("Open")).clicked() {
+                    app.open_dialog();
+                }
+                ui.add_space(8.0);
+                // Tabs: show all open document tabs
+                ui.spacing_mut().item_spacing.x = 2.0;
+                for i in app.tabs_in(Place::Main) {
+                    if let Some(name) = crate::canvas::tab_label(app, i) {
+                        let is_active = app.active == Some(i);
+                        let mut action = None;
+                        let response = ui.selectable_label(is_active, name);
+                        if response.clicked() {
+                            action = Some(i);
+                        }
+                        if let Some(idx) = action {
+                            app.active = Some(idx);
+                            app.combine_tab.focused = false;
+                        }
+                    }
+                }
+                // Discord button
+                if icons::button(ui, "discord", button, false, "Discord").clicked() {
+                    let _ = webbrowser::open("https://discord.gg/artcraft");
+                }
+                ui.add_space(8.0);
+                // Exit viewer mode button
+                if ui.button(tl!("Exit Viewer")).clicked() {
+                    app.viewer_mode.enabled = false;
+                }
+                ui.add_space(8.0);
+                // Window controls
+                if !controls.right.is_empty() {
+                    ui.scope(|ui| {
+                        ui.spacing_mut().item_spacing.x = 0.0;
+                        window_controls::buttons(ui, &controls.right);
+                    });
+                }
+            });
+        });
+}

+//! Viewer Mode - A clean, minimal multi-PDF viewer
+//!
+//! This module provides a streamlined UI for viewing multiple PDFs simultaneously,
+//! similar to browser tabs. All chrome, panels, and tools are hidden for a clean view.
+//! Toggle between Full UI and Viewer mode with the button in the tab strip.
+
+use egui::{Color32, Margin, ScrollArea, Vec2, Ui, TextStyle};
+
+use crate::{chrome, panes, tiles_ui, viewer_prefs, PdfCraftApp, RECENT_FILES_DEFAULT};
+use pdfcraft_engine::{DocId, RenderPool, Session};
+use pdfcraft_render::{EffectiveScale, PageImage, PageRenderer, RenderConfig, RenderRequest, RequestKind};
+
+pub struct ViewerMode {
+    pub enabled: bool,
+}
+
+impl Default for ViewerMode {
+    fn default() -> Self {
+        Self { enabled: false }
+    }
+}
+
+impl ViewerMode {
+    pub fn is_hidden(&self) -> bool {
+        self.enabled
+    }
+
+    pub fn toggle(&mut self) {
+        self.enabled = !self.enabled;
+    }
+}
+
+impl PdfCraftApp {
+    pub fn toggle_viewer_mode(&mut self) {
+        self.viewer_mode.toggle();
+    }
+
+    pub fn viewer_mode_hidden(&self) -> bool {
+        self.viewer_mode.enabled
+    }
+}
+
+pub fn draw_viewer_tab_strip(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    
+    egui::TopBottomPanel::top("viewer_tab_strip")
+        .exact_height(36.0)
+        .frame(egui::Frame::none().fill(t.titlebar))
+        .show(ui, |ui| {
+            ui.horizontal(|ui| {
+                ui.add_space(8.0);
+                
+                ui.label("Tabs:");
+                ui.add_space(8.0);
+                
+                ui.vertical(|ui| {
+                    ui.set_width(400.0);
+                    ScrollArea::horizontal()
+                        .lag_to_scroll(false)
+                        .show_scrollbar(false)
+                        .show(ui, |ui| {
+                            ui.horizontal(|ui| {
+                                ui.add_space(4.0);
+                                
+                                if let Some(active) = app.active {
+                                    if let Some(label) = crate::canvas::tab_label(app, active) {
+                                        if ui.button(&label).clicked() {
+                                            app.active_tabs.focus();
+                                        }
+                                    }
+                                }
+                                
+                                for (i, view) in app.views.iter().enumerate() {
+                                    if i == app.active.unwrap_or(usize::MAX) {
+                                        continue;
+                                    }
+                                    if let Some(label) = crate::canvas::tab_label(app, i) {
+                                        let is_open = ui.button(&label).clicked();
+                                        if is_open {
+                                            app.active = Some(i);
+                                        }
+                                    }
+                                }
+                            });
+                        });
+                });
+                
+                ui.add_space(12.0);
+                ui.separator();
+                ui.add_space(12.0);
+                
+                if ui.button("Exit Viewer").clicked() {
+                    app.viewer_mode.enabled = false;
+                }
+                
+                ui.add_space(8.0);
+                
+                if ui.button("Open…").clicked() {
+                    let _ = app.request_open_files(None);
+                }
+            });
+        });
+}
+
+pub fn draw_viewer_document_area(app: &mut PdfCraftApp, ui: &mut egui::Ui, doc_index: usize) {
+    let Some(active) = app.active else {
+        ui.label("No document open. Click \"Open\" or drag PDFs onto the window.");
+        return;
+    };
+    
+    if doc_index != active {
+        return;
+    }
+    
+    let Some(view) = app.views.get(active) else { return };
+    let Some(doc) = app.session.get(view.id) else { return };
+    
+    let max_texture_size = ui.ctx().max_texture_size().unwrap_or(4096) as u32;
+    
+    if let Ok(pixmap) = app.request_page_image(
+        view.id,
+        view.current_page,
+        96.0 * view.zoom as f64,
+        max_texture_size,
+    ) {
+        let texture = ui.ctx().load_texture(
+            &format!("viewer_page_{}", view.current_page),
+            &pixmap,
+            egui::TextureOptions {
+                mag_filter: egui::FilterMode::Linear,
+                min_filter: egui::FilterMode::Linear,
+                wrap: egui::Wrapping::Clamp,
+            },
+        );
+        
+        let available = ui.available_size();
+        let image = egui::image::WaitForTexture::new(&texture);
+        
+        ui.add(image);
+        
+        ui.add_space(10.0);
+        draw_viewer_navigation(ui, view);
+    }
+}
+
+fn draw_viewer_navigation(ui: &mut egui::Ui, view: &crate::canvas::DocView) {
+    ui.horizontal(|ui| {
+        if ui.button("Prev").disabled(view.current_page == 0).clicked() {
+            if view.current_page > 0 {
+                let _ = ui.ctx().send_viewport_cmd(egui::ViewportCommand::None);
+            }
+        }
+        ui.add_space(10.0);
+        ui.label(format!("{} / {}", view.current_page + 1, view.page_count()));
+        ui.add_space(10.0);
+        if ui.button("Next").disabled(view.current_page >= view.page_count() - 1).clicked() {
+            if view.current_page < view.page_count() - 1 {
+                let _ = ui.ctx().send_viewport_cmd(egui::ViewportCommand::None);
+            }
+        }
+        ui.add_space(20.0);
+        let zoom_label = format!("{:.0}%", view.zoom * 100.0);
+        ui.label(&zoom_label);
+    });
+}

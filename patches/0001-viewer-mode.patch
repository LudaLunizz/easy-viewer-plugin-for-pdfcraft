+#[test]
+fn viewer_mode_pages_turn_with_the_page_keys() {
+    let three = String::from_utf8(PDF.to_vec())
+        .unwrap()
+        .replace("/Kids [3 0 R] /Count 1", "/Kids [3 0 R 4 0 R 5 0 R] /Count 3")
+        .replace("trailer", "4 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 400] >> endobj\n5 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 400] >> endobj\ntrailer")
+        .into_bytes();
+    let mut h = Harness::builder().with_size(egui::vec2(1400.0, 900.0)).build_eframe(move |_cc| {
+        let mut app = PdfCraftApp::new();
+        app.set_option("language", "en").unwrap();
+        app.open_bytes("three.pdf", None, three).expect("opens");
+        app
+    });
+    h.run_steps(4);
+    h.state_mut().execute("view.viewer_mode");
+    h.run_steps(3);
+    let page = |h: &Harness<'static, PdfCraftApp>| h.state().views[0].current;
+    assert_eq!(page(&h), 0);
+    h.key_press(Key::End);
+    h.run_steps(3);
+    assert_eq!(page(&h), 2, "End goes to the last page");
+    h.key_press(Key::Home);
+    h.run_steps(3);
+    assert_eq!(page(&h), 0, "Home goes to the first page");
+}
